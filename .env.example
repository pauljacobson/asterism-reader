NODE_ENV=development
APP_ORIGIN=http://localhost:4320
WORDPRESS_URL=https://wordpress.example.com
# Label shown by your passkey manager; does not change the account identity.
OWNER_NAME=Reader
PORT=4320
DATABASE_PATH=./data/asterism.sqlite
# Production requires an absolute path on persistent storage, e.g. /data/asterism.sqlite.
# Generate 32 random bytes as 64 hexadecimal characters; never commit the real key.
ENCRYPTION_KEY=
# SHA-256 of a random one-use owner invitation, with an explicit expiry.
OWNER_INVITE_HASH=
OWNER_INVITE_EXPIRES_AT=

# Structured diagnostics: debug, info, warn, error. Debug is normally disabled.
# Logs use a separate logs.sqlite file beside the account database.
LOG_LEVEL=info
